#import "../literature-template.typ": work


#work(
  title: "Zaklínač I: Poslední přání (zrnko pravdy)",
  author: "Andrzej Sapkowski",
  year: 1993,
  characteristics: (
    obsah: [
      Podle obsahu řadíme k epice. Podle formy próza. Z hlediska žánru fantasy soubor povídek.
    ],
    utvary: [
      Povídka – kratšího rozsahu; s malým počtem postav a jednoduchým dějem.
    ],
    name-meaning: [ 
      Název odkazuje na hlavní postavu zaklínače.
    ],
    tema: [ 
      Boj s příšerami, nadpřirozené postavy. Zaklínač chrání lidi před nebezpečnými bytostmi
    ],
  ),
  literary-context: (
    umelecke-smer: [
      V reakci na 2 sv. válku vzniká lit. směr fantasy - užívání magie či nadpřirozených prvků v literatuře. Jejich inspirace pochází z mýtů, pohádek nebo legend. Jeden z nejpopulárnějších žánrů současnosti. Povídka zrnko pravdy našla insipraci v pohádce kráska a zvíře.
    ],
    historicke-souvislosti: [
      Pád komunismu v Polsku: Sapkowski psal v době přerodu Polska z totalitního režimu na demokracii (přelom 80. a 90. let). Tato nejistá doba se odráží v nihilismu postav a rozpadu starých hodnot. Demystifikace hrdiny: Zatímco dřívější fantasy (např. Tolkien) byla o jasném boji dobra proti zlu, Sapkowski reaguje na realitu 20. století, kde je hranice mezi dobrem a zlem nejasná (tzv. "menší zlo"). Vliv slovanské identity: V době psaní v Polsku dominovala západní literatura. Sapkowski do žánru vnesl specificky východoevropský, cynický a plebejský tón.
    ],
    soucasnici: [
      *Světoví*
        - John Ronald Reuel Tolkien (pán prstenů, hobit)
        - Robert Ervin Howard (Conan)
        - Terry Pratchett (úžasná zeměkoule)
      *Český*
        - Jiří Kulhánek (Soumrak)
    ],
    autoruv-zivot: [
      Narodil se v Lodži 1948 a stále žije. Vystudoval vysokou školu ekonomickou (obchod v zahraničí) a dlouhá léta pracoval jako zástupce prodejce a ekonom v zahraničním obchodě. Tato zkušenost mu dala pragmatický pohled na svět, který přenesl i na Geralta (zaklínač jako "živnostník", který musí smlouvat o ceně). K psaní se dostal náhodou v 38 letech, když se přihlásil do soutěže literárního časopisu, aby dokázal, že dokáže napsat lepší fantasy než ty, které se tehdy překláda. Jeho hluboké znalosti historie, etymologie a světových mytologií mu umožnily vytvořit svět, který působí historicky věrně, i když je v něm magie.
    ],
    dalsi-dila: [
       - Meč osudu (povídka)
       - Sága o zaklínači (fantasy román)
       - Oko Yerrhedesa (drama)
    ],
  ),

  kompozice: [
    Rětězový děj. Dílo je složeno z mnoha volně řazených příběhů, nelze určit jak jejich posloupnost. 
  ],
  obsah-dila: [
    Geralt najde poblíž cesty dvě těla a způsob zabití nasvědčuje přítomnosti nebezpečné příšery. Stopy dovedou zaklínače ke stavení, kterému vládne zvláštní tvor jménem Nivellen, napůl člověk, napůl zvíře.  Nivell o dvanáct let dříve proklela kněžka kultu a on se změnil v zubatou bestii s lidským tělem. Několik let se snažil zlomit kletbu, tak jak o slyšel v pohádkách, tedy polibkem od sličné panny. Ale žádná s Nivellem nevydržela dlouho, až na tu poslední. Jmenovala se Vereen a jak později Geralt odhalil, jednalo se o bruxu (bestie). Vereen svého společníka pomalu vysávala. Poté co se Nivell od Geralta dozvěděl, co je Vereen zač, společně ji se zaklínačem zabili.
  ],
  postavy: [
    - Geralt z Rivie (bělovlasý zaklínač, hlavní postava)
    - Marigold (geraltův přítel, trubadůr)
    - Yennefer z Vengerbergu (čarodějka, geraltova láska - džin)
    - Nenneke (léčitelka, uzdravuje geralta)
  ],
  vypravecsky-zpusob: [
    Dílo je psáno er-formou. Obsahuje dialogy postav, přímou řeč. Slohový postup vyprávěcí popisný.
  ],
  jazyk-dila: [
    Spisovný i nespisovný jazyk, přímá řeč, archaismy, fantastické prvky (názvy bytostí, rostlin). zaklínačský slang, vulgarismy.
  ],

  ohlas-dila: [
    Jak povídky tak i romány jsou velmi oblíbené a úspěšné. Vznikly také hry od CD project red a byly natočeny jak amatérské tak i profesionální seriály. Vznikl také nezpočet komiksů a vymyšlených příběhů.
  ],
)