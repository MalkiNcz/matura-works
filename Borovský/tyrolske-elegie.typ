#import "../literature-template.typ": work


#work(
  title: "Tyrolské elegie",
  author: "Karel Havlíček Borovský",
  year: 1852,
  characteristics: (
    obsah: [
        Podle obsahu řadíme k epice, místy lyrické prvky. Podle formy poezie. Z hlediska žánru satirická básnícká skladba.
    ],
    utvary: [
      Satira = kritika nedostatku humorem; satira často kritizuje až útočně, odsuzuje; satira využívá výsměch, ironii a sarkasmus. 
    ],
    name-meaning: [ 
        Název odkazuje na místo, kam byl autor poslán do vyhnanství tyrolsko - brixen. Obsahuje také název žánru - elegie.
    ],
    tema: [ 
        zatčení a následná cesta Čech do brixenu.
    ],
  ),
  literary-context: (
    umelecke-smer: [
      Tvrobu řadíme do období, kdy v českých zemích vrcholí národní obrození (pol. 19. století). V jeho tvorbě se nachází prvky realismu. 
      Tyrolské elegie sepsal K.H.B během svého pobytu v Brixenu, spolu s dalšími satirami Králem Lávrou a Křestem Svatého Vladímíra (nedokončeno)
    ],
    historicke-souvislosti: [
         K.H.B. tvořil v době, kdy české země byly součástí habsburské monarchie, a kdy byla roku 1848 poražena revoluce požadující autonomii (vlastní ústavu) v rámci habsburské monarchie, 50. léta jsou pak ve znamení tuhého tzv. bachovského absolutismu (cenzura, perzekuce, potírání protimonarchistických názorů, snah, působení tajné policie); 
    ],
    soucasnici: [
      *Světoví*
      - N. V. Gogol - Revizor (Rusko, realismus)
      - Honore de Balzac - Otec Goriot (Francie, realismus)
      - Edgar Allan Poe - Havran (USA, romantismus)
      *Český*
      - Karel Jaromír Erben (Kytice)
      - Božena Němcová (Babička)
      - Karel Hynek Mácha (Máj)
    ],
    autoruv-zivot: [
        K. H. B. se narodil r. 1821 a zemřel r. 1856. 
        Byl to český básník, novinář a politik a současně příslušník 2. generace národních buditelů. 
        Je považován za zakladatele moderní české žurnalistiky a politické satiry a velký kritik habsburské monarchie. 
        Narodil se v Borové (přídomek Borovský"), gymnázium navštěvoval v Německém (dnes Havlíčkově) Brodě. 
        Studoval filozofii v Praze, vstoupil a následně odešel z kněžského semináře kvůli panujícím poměrům (kritik římskokatolické církve - kritik instituce). 
        Absolvoval počátkem 40. let 19. stol. cestu do Ruska, kde pobýval jako vychovatel v rodině vysokoškolského profesora, po ročním pobytu se vrátil, po této cestě změnil názor. 
        Začal se věnovat tištěné tvorbě, od r. 1846 byl redaktorem Pražských novin (na doporučení Františka Palackého), 
        za revoluce r. 1848 se stal redaktorem Národních novin (1. ryze český deník, velmi kritický vůči absolutistickému režimu) 
        po potlačení revoluce 1848 byl uvězněn, avšak zvolen poslancem do říšského sněmu, kvůli získané imunitě byl propuštěn. 
        Roku 1850 byly Národní noviny zakázány, z Prahy odešel do Kutné Hory, kde založil časopisu Slovan, r. 1851 byl nucen vydávání Slovanu zastavit, následovaly další soudní procesy. 
        Navrátil se do Německého Brodu, kde žil v ústraní. V zimě r. 1851 byl deportován do tyrolského Brixenu, kde byl důsledně střežen. 
        Roku 1855 mu byla povolena cesta za rodinou do Německého Brodu (po cestě se dozvěděl o smrti manželky). 
        Zemřel v Praze r. 1856 na tuberkulózu, následoval mučednický pohřeb s účastí Boženy Němcové, Františka Palackého nebo Karla Jaromíra Erbena. 
    ],
    dalsi-dila: [
        - Obrazy z Rus Epigramy 
        - Epištoly kutnohorské
        - Král Lávra 
        - Křest sv. Vladimíra
    ],
    
  ),
  kompozice: [
    Dílo je vyprávěno chronologicky ale táké retrospektivně, kdy autor vypráví příběh zatčení a cesty do Brixenu. Báseň je rozdělena do 9 částí, označení římskými číslicemi.
  ],
  obsah-dila: [
    V díle autor líčí satiricky svoje zatčení a deportaci do Brixenu. I. zpěv - autor rozmlouvá s měsícem; II., III., IV. zpěv - zatčení; V. - loučení s rodinou; VI., VII., VIII. - noční přejezd z Brodu do Waidringu (scéna: koně se splaší, polic. doprovod spadne z kočáru a havlíček sám dojede do hostince, kde povečeří a počká na policajty); IX - příjezd do Brixenu
  ],
  postavy: [
    - Borovský (vypravěč, hlavní postava, nebojácný, statečný)
    - Komisař Dedera¨
    - Rodina K.H.B
    - Policajti
  ],
  vypravecsky-zpusob: [
    Autor je zárověň vypravěč, jedná se o ich-formu (monolog vypravěče, nevlastní přímá řeč), přímá řeč
  ],
  jazyk-dila: [
    Spisovný jazyk (také hovorová čeština) i nespisovným jazykem (obecná čeština). V textu jsou hojně užity slova expresivně zabarvená, archaismy i slovní obraty z němčiny a latiny.
  ],
  ohlas-dila: [
    Tyrolské elegie byly veřejností přijaty velmi kladně, avšak musely být tajně opisovány, vyjít tiskem nemohly. Velký ohlas získalo dílo zvláště po autorově smrti. V Rusku vyšly Tyrolské elegie dokonce o rok dříve (1860), než mohly být uveřejněny v Čechách. Dále následovaly překlady do chorvatštiny a ukrajinštiny.
  ],
)