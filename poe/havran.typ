#import "../literature-template.typ": work


#work(
  title: "Havran",
  author: "Edgar Allan Poe",
  year: 1845,
  characteristics: (
    obsah: [
        Podle obsahu řadíme k lyrycko-epické báseni. Podle formy poezie. Z hlediska žánru baladadicá báseň.
    ],
    utvary: [
      Balada je lyricko-epická veršovaná skladba s dějem, který má rychlý spád, často obsahuje dialogy a končí tragicky.
    ],
    name-meaning: [ 
        Název je odvozen od havrana, který se v díle objevuje a říká stále "nevermore".
    ],
    tema: [ 
        Muž nemuže spát a vzpomíná na svou mrtvou lásku Lenoru, když se objeví havran a rozmlouvá s ním.
    ],
  ),
  literary-context: (
    umelecke-smer: [
      Tvorbu E.A.P. řadíme do období romantismu, na vzestupu je také realistická literatura. E.A.P. napsal Havrana v pozdním období své tvorby, vyšla 1945.
    ],
    historicke-souvislosti: [
      E.A.P. tvořil v době, kdy ve Spojených státech vznikají z původních britských kolonií další americké státy (1816- 1859) a zároveň je to období vznikajících sporů mezi severními a jižními státy, kvůli odlišnému politickému postoji k otroctví, později vedoucí k americké občanské válce (1861-1865);
    ],
    soucasnici: [
      *Světoví*
      - Victora Hugo (fr. romantismus; Chrám Matky Boží v Paříži)
      - Alexandra Dumase st. (fr. romantismus; Tři mušketýři)
      - Alexandra Sergejeviče Puškina (rus. romantismus; Evžen Oněgin)
      - Charlese Dickense (angl. realismus; Oliver Twist)
      - Honoré de Balzaca (fr. realismus; Otec Goriot)
      - Nikolaje Vasiljeviče Gogola (rusk. realismus; Revizor)
      *Český*
      - Karla Hynka Máchu (Máj)
      - Karla Jaromíra Erbena (sběratelská činnost, pohádky, Kytice)
      - Boženu Němcovou (sběratelská činnost, pohádky, Babička)
      - Karla Havlíčka Borovského (novinářská činnost, Tyrolské elegie, Král Lávra, Křest sv. Vladimíra);
    ],
    autoruv-zivot: [
      E.A.P se narodil 1809 a zemřel 1849; E.A.P. byl všestranný americký romantický básník, prozaik, esejista, novinář, zakladatel moderního detektivního a hororového žánru. Narodil se v Bostonu, brzy se stal sirotkem, byl adoptován rodinou Allanů, kvůli problémům s alkoholem a drogami nedokončil vysokoškolská studia, dostavily se také stavy deprese (během nich často tvořil). Věnoval se novinařině, významněji začal tvořit ve 30. letech 19. stol.; r. 1835 získal práci šéfredaktora; v r. 1845 vyšla v časopise, pro který pracoval, úspěšná báseň Havran. Tím si vydobyl společenské postavení, stále však měl problémy s alkoholem, znovu zchudl a v Baltimoru r. 1849 zemřel jako nemajetný.
    ],
    dalsi-dila: [
      *Hororové povídky*
      - Jáma a kyvadlo, černý kocour
      *Detektivní povídky*
      - Vražda v ulici Morgue, odcizený dopis
      *Básně*
      - Havran, Annabel Lee
    ],
    
  ),
  kompozice: [
    Chronoligické s prvky retrospektivní, stoupá | klesá napětí, 18 slok, gradace a kontrast
  ],
  obsah-dila: [
    Muž tráví osamělou noc v pokoji, vzpomíná na mrtvou lásku Lenoru a u toho čte. V tom se ozve zaklepání na dveře, později na okenice. Muž jde otevřít a šeptá do noci "Lenoro", nikde nikdo. Když dojde zpět, opět klepání na okenice, po otevření vletí černý havran a usadí se na bíle buste Pallas Athény. Muž s ním začne rozmlouvat načež havran odpoví "nevermore". Diví se ale začne se ho ptát na otázky, např. zda po smrti nalezne klid nebo zda uvidí Lenoru. havran odpovídá stále "nevermore". Muž se časem rozčílí a snaží se havrana vyhnat načež on stále sedí na místě a opakuje "nevermore". Havran neodletí a muž se stále utápí v žalu a zoufalství. Havran už nikdy neopustí jeho duši.
  ],
  postavy: [
    - Muž (oplakává zesnulou ženu)
    - Havran (symbol smrti, zná všechny odpovědi)
    - Lenora (mrtvá láska muže)
  ],
  vypravecsky-zpusob: [
    Dílo je vyprávěno v ich-formě, monologem muže (přímá řeč).
  ],
  jazyk-dila: [
    Knižní výrazy (poetismy - např. dí, světice, šramot), archaismy, epiteton, symbolismus, spisovně, užití tropů a figur, refrén (nevermore).
  ],
  ohlas-dila: [
    Poe ovlivnil svou tvorbou řadu dalších básníků např. Baudelaira, Bretona, Nezvala apod. Více překladů, např. "nevermore" je přeloženo jako "víckrát ne", "nikdy víc" nebo v originále.
  ],
  ctenar: [
    gut ale pochopil jsem to až na potřetí.
  ],
)