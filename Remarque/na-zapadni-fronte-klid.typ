#import "../literature-template.typ": work


#work(
  title: "Na západní frontě klid",
  author: "Erich Maria Remarque",
  year: 1929,
  characteristics: (
    obsah: [
        Podle obsahu řadíme k epice. Podle formy próza. Z hlediska žánru válečný román.
    ],
    utvary: [
      Román – děj se odehrává v delším časovém období, dílo obsahuje více postav se spletitými osudy.
    ],
    name-meaning: [ 
        Název odkazuje na větu která se ozve po smrti posledního z přátel na konci války "na západní frontě klid"
    ],
    tema: [ 
        Tématem je první světová válka, jaký má dopad na mladé muže, kteří narukovali a její nesmyslnost a absurdita.
    ],
  ),
  literary-context: (
    umelecke-smer: [
        Ztracená generace - Tito spisovatelé zažili první světovou válku a tuto skutečnost zobrazovali ve svých dílech. Vyjadřují pocity vojáků po návratu z války (vrátili se duševně zmrzačeni a měli problémy se zařazením se do společnosti). Pro tyto autory jsou typické životní postoje, kterými dávají najevo nesouhlas a nedůvěru ke společnosti, jejich psaní je často blízké ke stylu novin, často staví své hrdiny do velmi nebezpečných situací, kde musí prokazovat svůj charakter.
    ],
    historicke-souvislosti: [
        První světová válka způsobila v celé Evropě hluboký společenský i duchoví otřes. Velmi výraznou stopu zanechala také v literatuře. Zobrazování válečné tématiky si klade za cíl vylíčit válečné hrůzy a varovat před nimi. Řada světových známých spisovatelů se angažuje v protiválečném hnutí. Téma války silně ovlivnilo i Remarque.
    ],
    soucasnici: [
      *Světoví*
        - Romain Rolland (Petr a lucie)
        - Ernest Hemingway (Sbohem armádo)
        - William Faulkner (Sartoris)
      *Český*
        - Jaroslav Hašek (Osudy dobrého vojáka švějka)
        - Karel Čapek (matka)
    ],
    autoruv-zivot: [
        Vlastním jménem Erich Paul Remark byl německý prozaik a dramatik. Syn vazače knih, nejprve chtěl být hudebníkem a malířem. 1916 odešel jako dobrovolník do války, kde byl raněn. Vystřídal několik povolání, ale nedokázal se plně začlenit do společnosti. Vydává román na západní frontě klid, který se okamžitě stává hitem. Po nástupu fašismu nacisté nepravdivě popřeli jeho účast v 1 s.v. a označili ho za žida.  Se stal zakázaným autorem, byl zbaven německého občanství a emigroval do usa. Po válce se vrátil do švýcarska. Zemřel na srdeční chorobu. 
    ],
    dalsi-dila: [
       - Cesta zpátky
       - Tři kamarádi
       - Miluj bližního svého
    ],
  ),

  kompozice: [
    Dílo je psáno chronologicky s prvky retrospektivy. Je rozděleno do 2 kapitol označených římskými číslicemi.
  ],
  obsah-dila: [
    Pavel se svými kamarády Müllerem, Kroppem, Kemmerichem a Leerem je silným nátlakem především třídního profesora narukovat a později být odveden na frontu. Po náročném výcviku plném Himmelstossova šikanování zažívají zákopové boje na frontě v první linii. Zde se Pavel setká s Katczinskym, který je zde nejstarší. V prvním boji Kemmerich schytá ránu do nohy, kterou mu musí amputovat. Na svoje zranění nakonec podlehne. Jejich rota trpí velkými ztrátami a všichni si uvědomují důležitost přátelství. Při proti-útoku umírá jejich kamarád Westhus, jehož tělo odnesl právě nenáviděný Himmelstoss. Usmíří se s ním a pracují chvíli s ním v kuchyni. Pavel dostane dovolenku a odjíždí domů, kde zjistí, že matka má rakovinu. Po návratu je nejprve přidělen do výcvikového tábora, kde hlídá ruské zajatce. Po návratu ke své rotě není Pavel se své kůži a při průzkumu zůstane trčet v trychtýři, kam za ním spadne nepřátelský voják, kterého pobodá a pak během celého dne čekání na noc má výčitky svědomí. Po návratu a shledání s přáteli jsou převeleni na hlídání opuštěné vesnice, kde mají klid a dostatek jídla. Během dalšího úkolu evakuovat další vesnici je zraněn i pavel a kropp, kterému amputují nohu. Po pavlově návratu zpět na frontu umírá další z přátel - Müller. V létě 1918, kdy němci prohrávají, zemře pavlův nejlepší a nejvěrnější kamarád Katcza. Pavel je z toho na dně, je sám a v říjnu 1918, kdy byl na západní frontě klid umírá.  
  ],
  postavy: [
    - Pavel Bäumer (vypravěč, poslední z kamarádů)
    - Stanislav Katczinsky (Katcza, nejlepší pavlův kamarád)
    - Albert Kropp (pavlův spolužák)
    - Müller (pavlův spolužák)
    - Leer (pavlův spolužák)
    - František Kemmerich (pavlův spolužák)
    - Himmelstoss (nadporučík, zneužívá moci)
    - Tjaden (kamarád z války)
    - Detering (kamarád z války)
  ],
  vypravecsky-zpusob: [
    Román je psán v ich-formě (pavel), závěrečná zpráva o jeho smrti je er-forma.
  ],
  jazyk-dila: [
    Spisovný jazyk, přímá řeč (dialog mezi vojáky), archaismy, vulgarismy, slangové a hovorové výrazy, personifikace a přirovnání.
  ],

  ohlas-dila: [
    Po nástupu nacismu se dostal mezi zakázané autory a v roce 1938 byl zbaven německého občanství. Nacistická propaganda prohlásila, že Erich Maria Remarque je ve skutečnosti Paul Kramer (tedy Remarque pozpátku), Žid, který se nikdy nezúčastnil první světové války, tedy nemůže ji popisovat. Dnes je dílo velmi oceněno a patří mezi nejlepší válečná díla.
  ],
)