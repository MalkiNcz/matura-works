    ],
    tema: [ 
        Nebojácná pastýřova dcera Bára zbaví kamarádku nemilého nápadníka a sama se provdá za myslivce. Boj za lepší postavení žen.
    ],
  ),
  literary-context: (
    umelecke-smer: [
      Tvrobu řadíme do období, kdy v českých zemích vrcholí národní obrození (pol. 19. století). Převládá realismus s prvky romantismu.
    ],
    historicke-souvislosti: [
        Božena Němcová tvořila v době, kdy české země byly součástí habsburské monarchie, a kdy byla roku 1848 poražena revoluce požadující autonomii (vlastní ústavu) v rámci habsburské monarchie, 50. léta jsou pak ve znamení tuhého tzv. bachovského absolutismu (cenzura, perzekuce, potírání protimonarchistických názorů, snah, působení tajné policie); 
    ],
    soucasnici: [
      *Světoví*
      - N. V. Gogol - Revizor (Rusko, realismus)
      - Honore de Balzac - Otec Goriot (Francie, realismus)
      - Edgar Allan Poe - Havran (USA, romantismus)
      *Český*
      - Karel Jaromír Erben (Kytice)
      - Karel Havlíček Borovský (Král Lávra)
