#work(
  title: "Divá Bára",
  author: "Božena Němcová",
  year: 1856,
  characteristics: (
    obsah: [
        Podle obsahu řadíme k epice. Podle formy próza. Z hlediska žánru povídka.
    ],
    utvary: [
      Povídka – kratšího rozsahu; s malým počtem postav a jednoduchým dějem.
    ],
    name-meaning: [ 
