#import "../literature-template.typ": work


#work(
  title: "Utrpení mladého Werthera",
  author: "Johann Wolfgang Goethe",
  year: 1774,
  characteristics: (
    obsah: [
        Podle obsahu řadíme k epice. Podle formy próza. Z hlediska žánru sentimentální/milostný román.
    ],
    utvary: [
      Sentimentální/milostný román je rozsáhlé epické dílo v próze, jehož hlavním cílem je vyjádřit hluboké city a emoce, často spojené s láskou a utrpením.
    ],
    name-meaning: [ 
        Název odkazuje na hlavní postavu mladého Werthera, který prožívá utrpení kvůli nešťastné lásce.
    ],
    tema: [ 
        Příběh mladého Werthera a jeho nešťastné lásky k Lottě.
    ],
  ),
  literary-context: (
    umelecke-smer: [
      Tvorbu řadíme do období preromantismu (přechod mezi klasicismem a romantismem). Kladen důraz na citů, prožitků, nálad, pocity melancholie a smutku. Sturm und Drang - Nejvýznamnější proud německého preromantismu. Název tohoto hnutí byl odvozen od stejnojmenné hry německého dramatika F.M.Klingera. Hnutí prosazovalo tvůrčí svobodu pro umělce , odmítalo společenské konvence, kritizovalo každou formu útlaku, do popředí kladlo cit , vášeň a fantazii . Ideálem byl návrat přírodě. Uznávali pouze autority jako je Shakespeare a Rousseau.
    ],
    historicke-souvislosti: [
        Seznámení s Herdrem, skupina mladých spisovatelů – označováno Sturm und Drang (bouře a vzdor). Přitahováni příkladem anglické literatury (Shakespeare = ideál tvůrčí svobody), díla skupiny téměř vždy skončila porážkou hrdiny. Podnětem k napsání Wethera bylo milostné vzplanutí k Charlottě Buffové ve Wetzlaru, Goethe zde vykonával soudní praxi. Konec je inspirován kolegou (mladý filozof K. W. Jerusalem), který si skutečně pujčil zbraň od Alberta Kestnera.
    ],
    soucasnici: [
      *Světoví*
      - Friedrich Schiller (Oda na radost, Loupežníci)
      - Jean Jacques Rousseau (Emil neboli O výchově)
      - George Gordon Byron (Childe Haroldova pouť)
      *Český*
      - Josef Dobrovský (Dějiny české řeči a literatury)
      - Václav Matěj Kramerius (Historie česká)
      - Antonín Jaroslav Puchmajer (bajka Vrána a liška)
    ],
    autoruv-zivot: [
        narozen 28.8.1740 ve Frankfurtu nad Mohanem, otec právník. Vystudoval práva v Lipsku a ve Štrasburgu - krátká praxe ve Wetzlaru. Vstoupil do vévodských služeb ve Výmaru (tajný rada, ministr, ředitel knihoven, divadla a vědeckých ústavů). Hodně cestoval po Německu, Švýcarsku, Itálii a západních čechách. Zemřel 22.3.1832 ve Výmaru.
    ],
    dalsi-dila: [
        - Prometheus (báseň, lidský vzdor bohům)
        - Faust (upsání duše ďáblu za služby)
        - Torquato Tasso (osud básníka a jeho sporu s dvorem)
        - Trilogie Vášně (protiklad Fausta, cesta chlapce ke zmoudření)
    ],
    
  ),
  kompozice: [
    Dílo je rozděleno na dva díly. První popisuje přistěhování, průběh života a následný odchod Wertera. Druhý se věnuje jeho působení na velvyslanectví, návrat a sebevraždu. Děj je chronologický, vyprávěný formou dopisů. Příběh je rámcován vypravěčovým úvodem v roli vydavatele a také závěrečnou zprávou o smrti W.
  ],
  obsah-dila: [
    Werther přijíždí na venkov aby se zde věnoval malování. Po nějaké době, kdy si užívá samoty jede Werther na ples s přítelkyněmi a Lottou, která po smrti matky má nastarost své sourozence. Je zasnoubená s Albertem, ale Werther se i přes to do ní na plese zamiluje. Následně ji skoro denně navštěvuje a chodí spolu na dlouhé procházky. Po čase přijíždí Albert a Werther nedokáže být v přitomnosti ženy, kterou miluje, ale která patří jinému. Odcházi proto do služeb na velvyslanectví, kde se seznámí s dívkou, která mu připomíná lottu, zárveň si však dopisuje s Lottou, která je již provdána. Po neshodách s úředníky místo opouští. Werther se vrací na venkou, kde znovu navštěvuje Lottu. Albert začíná žárlit, ale nedává nic najevo. Před Vánoci Albert odjíždí a Werther navštíví Lottu. Vyzná ji lásku a ona pozná, že ho nejspíš také miluje, ale nedokáže klamat manžela. Werther odchází domů, napíše dopis Lottě a pošle sluhu s prosbou o půjčení Albertových zbraní na cesty. Lotta tuší neštěství, avšak postrkována Albertem zbraně předá. Werther napíše rozlučný dopis Vilémovi, Albertovi a dokončí i dopis Lottě a o půlnoci téhož dne zastřelí. Sluha ho ráno najde a hned jde neštěstí oznámit otci Lotty. Před polednem Werther umírá. Je pohřben u dvou lip; v místě co si sám určil.
  ],
  postavy: [
    - Werther (mladý citlivý muž, umělec, zamilován do Lotty)
    - Charlotta "Lotta" (po smrti matky se stará o sourozence, Albertova snoubenka)
    - Albert (Lottin snoubenec)
    - Vilém (Wertherův blízký přítel, většina dopisů jsou adresovány jemu)
  ],
  vypravecsky-zpusob: [
    Příběh je vyprávěn v ich-formě (v závěru er-forma) prostřednictvím dopisů, které Werther píše svému příteli Vilémovi, ke konci také Lottě. Objevuje se přímá řeč. Vypravěč je přímo werther, v závěru neznamý vypravěč který vypravuje osud Werthera.
  ],
  jazyk-dila: [
    Spisovný jazyk, knižní výrazy, řečnické výrazy. Text obsahuje dlouhá souvětí, použití zdrobnělin, eufemismů (nahrazení drsného slova jemným), elips (vynechání věty). 
  ],
  ohlas-dila: [
    Utrpení mladého Werthera vyvolalo po vydání obrovský ohlas a stalo se symbolem hnutí Sturm und Drang. Mnoho mladých lidí se ztotožňovalo s Wertherovými city, což vedlo až k tzv. wertherovské horečce a kontroverzím kvůli spojování díla se sebevraždami. Román měl zásadní vliv na další vývoj romantické literatury.
  ],
  ctenar: [
    Dílo jsem si vybral i přes odrazování od přátel, kteří tvrdili, že je to hrozně náročné na čtení. Nakonec jsem byl překvapen, že se kniha četla poměrně dobře a rychle. Protože děj je přímočarý a jakékoli části knihy jsem věděl kde přibližně se hrdina nachází, dokážu přehlédnout občasné nudné a zdlouhavé pasáže. 
  ],
)