#import "../literature-template.typ": work


#work(
  title: "Král duchů",
  author: "Johann Wolfgang Goethe",
  year: 1782,
  characteristics: (
    obsah: [
        Podle obsahu řadíme k lyrice s epickými prvky (dějovost). Podle formy poezie. Z hlediska žánru balada.
    ],
    utvary: [
      Balada – lyricko-epický útvar s tragickým dějem, tajemnou atmosférou a dramatickým vyústěním.
    ],
    name-meaning: [ 
        Název odkazuje na nadpřirozenou nemoc, která představuje smrt a svádí malého chlapce.
    ],
    tema: [ 
        Smrt malého chlapce v náručí svého otce.
    ],
  ),
  literary-context: (
    umelecke-smer: [
      Tvorbu řadíme do období preromantismu (přechod mezi klasicismem a romantismem). Kladen důraz na citů, prožitků, nálad, pocity melancholie a smutku. Sturm und Drang - Nejvýznamnější proud německého preromantismu. Název tohoto hnutí byl odvozen od stejnojmenné hry německého dramatika F.M.Klingera. Hnutí prosazovalo tvůrčí svobodu pro umělce , odmítalo společenské konvence, kritizovalo každou formu útlaku, do popředí kladlo cit , vášeň a fantazii . Ideálem byl návrat přírodě. Uznávali pouze autority jako je Shakespeare a Rousseau.
    ],
    historicke-souvislosti: [
        Seznámení s Herdrem, skupina mladých spisovatelů – označováno Sturm und Drang (bouře a vzdor). Přitahováni příkladem anglické literatury (Shakespeare = ideál tvůrčí svobody), díla skupiny téměř vždy skončila porážkou hrdiny. 
    ],
    soucasnici: [
      *Světoví*
      - Friedrich Schiller (Oda na radost, Loupežníci)
      - Jean Jacques Rousseau (Emil neboli O výchově)
      - George Gordon Byron (Childe Haroldova pouť)
      *Český*
      - Josef Dobrovský (Dějiny české řeči a literatury)
      - Václav Matěj Kramerius (Historie česká)
      - Antonín Jaroslav Puchmajer (bajka Vrána a liška)
    ],
    autoruv-zivot: [
        narozen 28.8.1740 ve Frankfurtu nad Mohanem, otec právník. Vystudoval práva v Lipsku a ve Štrasburgu - krátká praxe ve Wetzlaru. Vstoupil do vévodských služeb ve Výmaru (tajný rada, ministr, ředitel knihoven, divadla a vědeckých ústavů). Hodně cestoval po Německu, Švýcarsku, Itálii a západních čechách. Zemřel 22.3.1832 ve Výmaru.
    ],
    dalsi-dila: [
        - Prometheus (báseň, lidský vzdor bohům)
        - Faust (upsání duše ďáblu za služby)
        - Torquato Tasso (osud básníka a jeho sporu s dvorem)
        - Trilogie Vášně (protiklad Fausta, cesta chlapce ke zmoudření)
    ],
    
  ),
  kompozice: [
    Báseň má pravidelnou slokovou stavbu (8 čtyřveršových slok). Děj je chronologický, dialog mezi otcem, synem a králem duchů. Gradace k tragickému konci.
  ],
  obsah-dila: [
    Otec veze umirajícího syna na koni domů do bezpečí. Chapcův stav se zhoršuje, začíná mít vidiny a vidí krále duchů, který ho volá k sobě. Chlapec se to snaží otci vysvětlit, ale ten krále duchů nevidí a říká, že to je jen mlha. Nakonec se král duchů chlapce dotkne a ten začne naříkat. Po příjezdu do dvora otec zjistí, že syn je mrtvý.
  ],
  postavy: [
    - Otec (snaží se utěšit syna)
    - Syn (umírá, má vidiny)
    - Král duchů (nadpřirozená bytost představující smrt)
  ],
  vypravecsky-zpusob: [
    Vypravěč je vševědoucí, popisuje dialog mezi postavami. Používá er-formu, dílo je retrospektivní.
  ],
  jazyk-dila: [
    Spisovný jazyk nautrální, archaismy (slova zastaralá), opakování, gradace.
  ],
  ohlas-dila: [
    Báseň patří k nejznámějším baladám světové literatury. Stala se symbolem preromantismu a inspirovala mnoho skladatelů (např. Franz Schubert). Dodnes je součástí školní literatury.
  ],
  ctenar: [
    Kvůli krátkosti díla jsem nenavázal žádný vztah a nijak na mě nazapůsobilo.
  ],
)