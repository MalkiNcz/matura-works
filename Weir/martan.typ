#import "../literature-template.typ": work


#work(
  title: "Marťan",
  author: "Andy Weir",
  year: 2014,
  characteristics: (
    obsah: [
        Podle obsahu řadíme k epice. Podle formy próza. Z hlediska žánru sci-fi román.
    ],
    utvary: [
      Román – děj se odehrává v delším časovém období, dílo obsahuje více postav se spletitými osudy.
    ],
    name-meaning: [ 
        Název odkazuje na hlavní postavu Marka Watneyho, který uvízne na marsu = Marťan.
    ],
    tema: [ 
        Příběh popisuje přežití člověka v extrémních podmínkách na marsu a snahu o návrat na zemi.
    ],
  ),
  literary-context: (
    umelecke-smer: [
        Současná literatura, hard sci-fi - klade důraz na vědeckou přesnost a realistické zobrazení technologií. Původně publikoval dílo na svém webu, 2014 vyšel knižně
    ],
    historicke-souvislosti: [
        Dílo vzniká v době obnoveného zájmu o vesmírný výzkum — NASA plánuje mise na Mars, SpaceX zahajuje komerční lety. Ve světě probíhají konflikty na Blízkém východě, vrcholí éra sociálních sítí a digitalizace. V ČR jsme součástí EU a NATO, ekonomika se zotavuje z globální finanční krize.
    ],
    soucasnici: [
      *Světoví*
        - George R.R. Martin (hra o trůny)
        - Suzanne Collins (hunger games)
        - Cormac McCarthy (Cesta)
      *Český*
        - Michal Viewegh (báječná léta pod psa)
        - Petra Soukupová (k moři)
        - Jaroslav Rudiš (Grandhotel)
    ],
    autoruv-zivot: [
        Narodil se v kalifornii jako syn fyzika a inženýrky. V 8 se rodiče rozvedli. V 15 začal pracovat jako programátor, univerzitu IT nedokončil. Pomáhal vytvořit Warcraft II. Začal psát kolem 20 a všechna díla publikoval na internetu. Marťana nejprve publikoval na webu, na žádost čtenářů prodával za 99 centů elektronickou podobu, později prodal práva společnosti Crown Publishing Group, která vydala tištěnou podobu.
    ],
    dalsi-dila: [
       - Artemis (sci-fi román)
       - project Hail Mary (sci-fi román)
       - Kastle (povídka)
    ],
  ),

  kompozice: [
    Dílo je složeno z deníkových záznamů Marka, které se prolínají s kapitolami z pohledu NASA a posádky lodi. Dílo je psáno chronologicky s prvky retrospektivy.
  ],
  obsah-dila: [
    V roce 2035 Mark Watney z mise Ares 3 uvízne na Marsu a ztratí kontakt se zemí, kde si všichni myslí že je mrtvý. On však bydlí v hubu a s věcmi, které tam jeho tým zanechal přežívá. Díky přistrojům a jeho znalostem začne pěstovat brambory. NASA se o něm dozví pomocí satelitů, ale nemůžou s ním komunikovat ani o něm neřeknou jeho týmu, který už je na zpáteční cestě na zemi. Pro Marka je jediná možnost dostat se na místo mise Ares 4, která začně za 1000 dnů. Upraví rovery a otestuje je během cesty k staré sondě Pathfinder. Po návratu k hubu se s ní spojí s NASA. Po nějaké době nevydrží tlak přechodová komora a praskne. Hub se zhroutí a brambory zmrznou. Na zemi se snaží vyrobit sondu, která by mu dopravila jídlo ale vybouchne. Rich purnell vypočítá trajektorii, kdy loď Hermes může vyzvednou Marka. NASA to zamítne ale posádka, ke které se info dostalo, chce misi podniknout. NASA pošle instrukce k upravě roveru na cestu, ale při práci dojde k poškození spojení. Během cesty se Mark vypořádá s Písečnou bouří a po příjezdu na místo upraví vzletový modul. Posádka Hermesu rozbije tlakovou komoru, aby zrychlili a stihli průlet Marka. Nakonec se vše podaří a Marka po 549 solech (sol = den na marsu) zachrání.
  ],
  postavy: [
    - Mark Watney (botanik a inženýr, vynalézavý, přeživší)
    - Melissa Lewis (Velitelka mise Ares 3)
    - Teddy Sanders (ředitel NASA)
    - Venkat Kapoor (vedoucí mise)
    - Posádka Hermes (Martinez, Johanssen, Beck, Vogel)
  ],
  vypravecsky-zpusob: [
    Kombinace ich-formy (Watneyho deníkové záznamy) a er-formy (kapitoly z nasa a od posádky). Objevuje se přímá i nepřímá řeč.
  ],
  jazyk-dila: [
    Hovorový až nespisovný jazyk v deníkových pasážích. Užity odborné výrazy z botaniky, fyziky a astronautiky. Časté použití humoru a sarkasmu.
  ],

  ohlas-dila: [
    Román se rychle stal světovým bestsellerem a byl přeložen do desítek jazyků. Byl podle něj v roce 2015 natočen stejnojmenný film, který získal Zlatý glóbus za nejlepší muzikál/komedii. Nasa označila dílo za jedno z nejrealističtějších zpracování versmírného přežití.
  ],
)