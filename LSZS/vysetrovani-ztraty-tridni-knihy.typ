#import "../literature-template.typ": work


#work(
  title: "Vyšetřování ztráty třídní knihy",
  author: "Ladislav Smoljak a Zdeněk Svěrák",
  year: 2008,
  characteristics: (
    obsah: [
      Podle obsahu řadíme k dramatu. Podle formy drama. Z hlediska žánru komediální divadelní hra.
    ],
    utvary: [
        Komedie – zachycuje skutečnost zábavně, vysmívá se chybám a nedostatkům, končí optimisticky.
    ],
    name-meaning: [ 
      Název odkazuje na zápletku ve hře.
    ],
    tema: [ 
      Duševní podpora během komunistické nadvlády.
    ],
  ),
  literary-context: (
    umelecke-smer: [
        Postmoderní drama s prvky mystifikace. Hra využívá princip tzv. „cimrmanologie“, což je specifický český humor založený na fiktivní postavě geniálního všeuměla Járy Cimrmana. Hra měla premiéru v roce 1967 a je to druhá nejstarší hra z repertoáru.
    ],
    historicke-souvislosti: [
        Hra měla premiéru v říjnu 1967 (v Malostranské besedě). Vznikla v období tzv. „tání“, kdy komunistický režim v Československu částečně uvolnil cenzuru, což umožnilo vznik autorských divadel malých forem a rozvoj intelektuálního humoru. Přestože je hra zasazena do dob Rakouska-Uherska, diváci v ní jasně četli parodii na tehdejší socialistické školství, byrokracii a absurditu autorit (ředitel, inspektor, rada), které se snaží marně vyvinout tlak na „neviditelné“ žáky.
    ],
    soucasnici: [
      *Světoví*
        - S. Beckett (čekání na godota)
        - Arthur Miller (smrt obchodního cestujícího)
      *Český*
        - Václav Havel (audience)
        - Milan Uhde (adaptace Olbrachtovy Balady pro banditu)
        - Pavel Kohout (život v tichém domě)
    ],
    autoruv-zivot: [
        Ladislav Smoljak - Vystudovaný pedagog (matematika–fyzika) a spoluzakladatel Divadla Járy Cimrmana, kde působil jako režisér, herce i autor. Mimo divadlo pracoval jako redaktor a stojí za vznikem populární ankety Zlatý slavík; Zdeněk Svěrák - Původní profesí učitel, který se později stal uznávaným scénáristou, hercem a textařem. Ve své tvorbě, jako je scénář k filmu Obecná škola nebo divadelní hry o Cimrmanovi, často čerpá z vlastních vzpomínek na dětství a pedagogickou praxi.
    ],
    dalsi-dila: [
       - Dobytí severního pólu
       - Švestka
       - Lijavec
    ],
  ),

  kompozice: [
    2 části: úvodní seminář (odborné referáty vedené herci, beseda, okolnosti vzniku, vysvětlení některých situací pro pochopení hry, interpretace) a samotná divadelní hra (po přestávce); posloupnost chronologická; jedno dějství
  ],
  obsah-dila: [
    Seminář je rozdělen do jednotlivých přednášek: Druhý liptákovský nález (cimrman nic na zahradě nezakopal), osobní vzpomínka (Dr. Svěrák a nález díla pod prknem), Cesta do Haliče (cimrman sjednotil zaostalé školství), Cimrmanova šesterka (6 zásad), futurismus (cimrman připravoval žáky na futurum), Separace průtokových poznatků (1/10 pamatovat, zbytek ne), Trestání učitele učitelem (netrestat žáky ale učitele), Názorné a úlekové fixace (vylekání na zapamatování), Mimoverbální komunikace (komunikace bez vyrušování), Oživlé dřevo (recitace s gesty - provázky), Hodina fyziky (světlo x tma, zvuk x ticho), Teorie poznání (víme vše, nevíme nic); Hra: Drama pojednává o snaze donutit žáky třídy 8. C k navrácení třídní knihy, která se ztratila před sedmi lety. Nejdříve je zkouší přesvědčit učitel, který jim povídá o tom, že je to pěkný žert, ale ještě vtipnější by bylo, kdyby se třídní kniha po 7 letech najednou objevila. Snaží se je vystrašit řečením své přezdívky strašný Láďa, ale nic nezabírá. Poté do třídy přichází pan ředitel. Učitel se baví s ředitelem o své třídě a říká řediteli, že si musí postěžovat. Chvíli se dohadují, protože ředitel tvrdí, že přehání, ale nepřehání. Ředitel se snaží žáky donutit třídní knihu vrátit opět neúspěšně. Do třídy vchází inspektor. Inspektor sleduje opakující se scénku s příchodem ředitele. Inspektor mluví o práci v kůlně a na podzimku. Mělo by to zvýšit kázeň. Ředitel si stěžuje panu inspektorovi, že se třídní kniha stále nenašla. Pan inspektor zjišťuje, kdo má ve třídě jedničku z chování, jeden chlapec má 2 zbytek třídy 3. Inspektor se také snaží z žáků vytáhnout ztracenou třídní knihu, ale neúspěšně. Do třídy dorazí zemský školní rada. Všichni jsou z něj celí špatní a pan zemský školní rada si vyndá svačinu a tím dá pokyn žákům, ať si vezmou svačiny a jdou ven.
  ],
  postavy: [
    - Ředitel 
    - Třídní učitel
    - Inspektor
    - Zemský školní rada
    - Žáci
  ],
  vypravecsky-zpusob: [
    Objevují se divadelní repliky, přímá řeč jednajících postav ve formě dialogů psané prózou; scénické poznámky; vypravěč nepřítomný
  ],
  jazyk-dila: [
    Spisovný jazyk; občas hovorové výrazy; vtipné názvy; inverze a záměrně špatné skloňování; nevulgární nadávky
  ],

  ohlas-dila: [
    Diváci zpočátku věřili, že Jára Cimrman byl skutečný český velikán. Kritika hru ocenila jako mistrovskou ukázku absurdního dramatu, které je však přístupné široké veřejnosti. Vyzdvihován je především kontrast mezi vážným tónem „vědců“ v semináři a komikou samotné hry. Stále se hraje v pozměněném obsazení. 
  ],
)