#import "../literature-template.typ": work


#work(
  title: "České nebe",
  author: "Ladislav Smoljak a Zdeněk Svěrák",
  year: 2008,
  characteristics: (
    obsah: [
      Podle obsahu řadíme k dramatu. Podle formy drama. Z hlediska žánru komediální divadelní hra.
    ],
    utvary: [
      Komedie – zachycuje skutečnost zábavně, vysmívá se chybám a nedostatkům, končí optimisticky.
    ],
    name-meaning: [ 
      Název odkazuje na prostředí hry, české nebe.
    ],
    tema: [ 
      Česká historie a probuzení hrdosti k českému národu.
    ],
  ),
  literary-context: (
    umelecke-smer: [
        Postmoderní drama s prvky mystifikace. Hra využívá princip tzv. „cimrmanologie“, což je specifický český humor založený na fiktivní postavě geniálního všeuměla Járy Cimrmana. Hra měla premiéru v roce 2008 a je to poslední objevené dílo Cimrmana.
    ],
    historicke-souvislosti: [
        Hra vznikla v období vrcholné popularity Divadla Járy Cimrmana, krátce před smrtí Ladislava Smoljaka (2010). Reflektuje únavu společnosti z politiky a hledání národní identity skrze humor. Samotná hra se odehrává v období 1. světové války (kolem roku 1918), kdy se láme historie a vzniká samostatné Československo. Autoři skrze postavy v nebi komentují klíčové momenty českých dějin a národní povahy.
    ],
    soucasnici: [
      *Světoví*
        - S. Beckett (čekání na godota)
        - Arthur Miller (smrt obchodního cestujícího)
      *Český*
        - Václav Havel (audience)
        - Milan Uhde (adaptace Olbrachtovy Balady pro banditu)
        - Pavel Kohout (život v tichém domě)
    ],
    autoruv-zivot: [
        Ladislav Smoljak - Vystudovaný pedagog (matematika–fyzika) a spoluzakladatel Divadla Járy Cimrmana, kde působil jako režisér, herce i autor. Mimo divadlo pracoval jako redaktor a stojí za vznikem populární ankety Zlatý slavík; Zdeněk Svěrák - Původní profesí učitel, který se později stal uznávaným scénáristou, hercem a textařem. Ve své tvorbě, jako je scénář k filmu Obecná škola nebo divadelní hry o Cimrmanovi, často čerpá z vlastních vzpomínek na dětství a pedagogickou praxi.
    ],
    dalsi-dila: [
       - Dobytí severního pólu
       - Švestka
       - Lijavec
    ],
  ),

  kompozice: [
    2 části: úvodní seminář (odborné referáty vedené herci, beseda, okolnosti vzniku, vysvětlení některých situací pro pochopení hry, interpretace) a samotná divadelní hra (po přestávce); posloupnost chronologická; jedno dějství
  ],
  obsah-dila: [
    Seminář je rozdělen do jednotlivých přednášek: Nález nové hry - obeznámení s okolnostmi nálezu, Cimrman žil za 1. sv. války, cimrmanova živá kopírka - diktoval hru žákům, maršálek Radecký, ukázka prvního cimrmanova dramatu - smil flaška a krabice, falešné rukopisy; Hra: Praotec Čech a Komenský čekají na sv. Václava a komenský zatím zkouší praotce. Vstoupí Václav, který se z důvodu první světové války rozhodl přijmout další 3 členy do nebeské komise. Přijmou tedy Jana Husa, Borovského, ale kvůli její pověsti nechcou vzít boženu němcovou. Vezmou tedy její babičku. Vstupuje Tyrš a vede sokolskou rozcvičku. Václav chce vyřídit žádosti z očistce. B. Smetanu přijmou do nebe, K. Sabinu - zrádce národa přijmou, ale V. Hanku a J. Lindu nechají v očistci. Opět vstupuje tyrš. Vstupuje Radecký, který si stěžuje, že češi dezertují a chtějí se vymanit z r-u. Nakonec Radecký chce rozpustit českou nebeskou komisi, načež ho václav vyžene a dá skrze tyrše vzkázat aby u nebeské brány brali všechny české vojáky bez rozdílu uniformy. Borovský vnukne ostatním myšlenku o obnovení samostatného českého království. Vybírají českého krále a vyberou "Tomáše Haryka Masaříka". Tyrš ukončí zasedání sestavou.
  ],
  postavy: [
    - Jan Ámos Komenský
    - Svatý Václav (vedoucí komise)
    - praotec Čech
    - Mistr Jan Hus
    - K. H. Borovský (vzdělaný, nejmladší člen komise)
    - babička Boženy Němcové (prostá osoba z lidu)
    - Miroslav Tyrš (vedoucí tělocviku v nebi)
    - maršálek Hradecký (povyšuje se, člen rakouské komise)
  ],
  vypravecsky-zpusob: [
    Objevují se divadelní repliky, přímá řeč jednajících postav ve formě dialogů psané prózou; scénické poznámky; vypravěč nepřítomný
  ],
  jazyk-dila: [
    Obecná, spisovná i nespisovná čeština; citace z národních písní a oper; germaismy a historismy
  ],

  ohlas-dila: [
    Hra byla přijata s velkým nadšením jako důstojné dílo cimrmanovského kánonu. Kritika oceňovala především hloubku postav (např. babička jako protipól intelektuálů) a schopnost dělat si legraci z národních nedotknutelných ikon. Existuje audiozáznam, televizní záznam a hra se stále hraje.
  ],
)